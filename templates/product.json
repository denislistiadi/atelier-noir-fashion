{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "collapsible_tab_materials": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fabric & Material Architecture",
            "icon": "shirt",
            "content": "<p>Engineered from 100% custom-milled natural fibers (480-520GSM). Sourced from certified heritage mills in Milan, Biella, and Wakayama. Free of microplastics and synthetic polymers.</p>",
            "page": ""
          }
        },
        "collapsible_tab_fit": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Fit & Architectural Proportions",
            "icon": "ruler",
            "content": "<p>Sculptural boxy silhouette with engineered shoulder drops and clean drape. Model is 185cm / 6'1\" wearing size Medium. We recommend your true size for the intended runway drape, or one size down for tailored fit.</p>",
            "page": ""
          }
        },
        "collapsible_tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Complimentary Shipping and Returns",
            "icon": "box",
            "content": "<p>• Express Worldwide Courier Dispatch (2-4 business days)<br/>• Complimentary shipping on all orders over $150<br/>• 14-day bespoke returns with pre-paid return labels included</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "buy_buttons",
        "description",
        "collapsible_tab_materials",
        "collapsible_tab_fit",
        "collapsible_tab_shipping",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "hover",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Complete The Ensemble",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}