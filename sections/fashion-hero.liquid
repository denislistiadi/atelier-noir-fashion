{%- style -%}
  .fashion-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_alignment }};
    overflow: hidden;
    background-color: #0d0d0d;
    color: #ffffff;
  }

  .fashion-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness({{ section.settings.image_brightness }}%);
    transform: scale(1.02);
    transition: transform 8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fashion-hero-{{ section.id }}:hover .fashion-hero-bg {
    transform: scale(1.06);
  }

  .fashion-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10,10,10,0.3) 0%, rgba(10,10,10,0.7) 100%);
  }

  .fashion-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 6rem 2rem;
    margin: 0 auto;
    text-align: {{ section.settings.text_align }};
  }

  .fashion-hero-tag {
    display: inline-block;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    font-weight: 600;
    color: #e5e5e5;
    margin-bottom: 1.6rem;
    padding: 0.5rem 1.4rem;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
  }

  .fashion-hero-title {
    font-size: clamp(3.2rem, 6vw, 6.4rem);
    font-weight: 800;
    letter-spacing: -1.5px;
    line-height: 1.05;
    margin: 0 0 2rem;
    text-transform: uppercase;
    color: #ffffff;
  }

  .fashion-hero-subtext {
    font-size: clamp(1.4rem, 1.8vw, 1.8rem);
    color: #cccccc;
    line-height: 1.6;
    max-width: 650px;
    margin: 0 auto 3.5rem;
    font-weight: 300;
    letter-spacing: 0.3px;
  }

  .fashion-hero-actions {
    display: flex;
    gap: 1.6rem;
    justify-content: {{ section.settings.text_align }};
    flex-wrap: wrap;
  }

  .fashion-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    color: #000000;
    font-size: 1.3rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 1.6rem 3.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .fashion-btn-primary:hover {
    background: #e0e0e0;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(255, 255, 255, 0.2);
  }

  .fashion-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #ffffff;
    font-size: 1.3rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 1.6rem 3.6rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .fashion-btn-secondary:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  .fashion-hero-footer {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 2;
    padding: 1.5rem 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 1.1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  @media screen and (max-width: 749px) {
    .fashion-hero-{{ section.id }} {
      min-height: 80vh;
    }
    .fashion-hero-footer {
      flex-direction: column;
      gap: 0.8rem;
      text-align: center;
      padding: 1.5rem 1rem;
    }
    .fashion-hero-actions {
      justify-content: center;
      width: 100%;
    }
    .fashion-btn-primary, .fashion-btn-secondary {
      width: 100%;
      padding: 1.4rem 2rem;
    }
  }
{%- endstyle -%}

<section class="fashion-hero-{{ section.id }}" role="banner">
  {%- assign default_img = "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop" -%}
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2200
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'fashion-hero-bg',
        alt: section.settings.heading
    }}
  {%- else -%}
    <img
      src="{{ default_img }}"
      alt="Atelier Noir Autumn Winter Collection"
      class="fashion-hero-bg"
      width="2070"
      height="1380"
      fetchpriority="high"
    >
  {%- endif -%}

  <div class="fashion-hero-overlay"></div>

  <div class="fashion-hero-content">
    {%- if section.settings.tagline != blank -%}
      <span class="fashion-hero-tag">{{ section.settings.tagline }}</span>
    {%- endif -%}

    <h1 class="fashion-hero-title">{{ section.settings.heading }}</h1>

    {%- if section.settings.subtext != blank -%}
      <p class="fashion-hero-subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <div class="fashion-hero-actions">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 | default: '/collections/all' }}" class="fashion-btn-primary">
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#editorial-spotlight' }}" class="fashion-btn-secondary">
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="fashion-hero-footer">
    <span>COLLECTION DROP // AW26-01</span>
    <span>PARIS • TOKYO • NEW YORK</span>
    <span>LIMITED PRODUCTION RUN</span>
  </div>
</section>

{% schema %}
{
  "name": "Fashion Hero Banner",
  "tag": "section",
  "class": "section-fashion-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Editorial Photo"
    },
    {
      "type": "range",
      "id": "image_brightness",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Brightness",
      "default": 80
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline / Badge",
      "default": "EDITION 04 — AUTUMN / WINTER 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "ARCHITECTURAL SILHOUETTE & DRAPING"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Meticulously crafted from 480GSM Japanese loopback cotton and structured double-faced wool. Engineered for modern brutalist elegance."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Text",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Text",
      "default": "VIEW LOOKBOOK"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button URL"
    }
  ],
  "presets": [
    {
      "name": "Fashion Hero Banner"
    }
  ]
}
{% endschema %}

