{%- style -%}
  .editorial-spotlight-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .editorial-spotlight-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .editorial-spotlight-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 4rem;
    align-items: center;
  }

  /* Left Column: Editorial Campaign Visual */
  .editorial-visual-wrap {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    background: #0d0d0d;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .editorial-visual-img {
    width: 100%;
    height: 100%;
    min-height: 600px;
    max-height: 720px;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-visual-wrap:hover .editorial-visual-img {
    transform: scale(1.03);
  }

  .editorial-visual-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2.5rem;
    background: linear-gradient(180deg, transparent 0%, rgba(10, 10, 10, 0.75) 100%);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    color: #ffffff;
    font-size: 1.1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .editorial-visual-tag {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.4rem 1.2rem;
    border-radius: 999px;
    font-weight: 600;
  }

  /* Right Column: Garments in Ensemble */
  .editorial-content-wrap {
    display: flex;
    flex-direction: column;
  }

  .editorial-subheading {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #888888;
    margin-bottom: 0.6rem;
    display: block;
    font-weight: 600;
  }

  .editorial-heading {
    font-size: clamp(2.6rem, 3.5vw, 4rem);
    font-weight: 700;
    margin: 0 0 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.8px;
    color: inherit;
  }

  .editorial-desc {
    font-size: 1.5rem;
    color: #666666;
    line-height: 1.6;
    margin: 0 0 2.5rem;
  }

  /* Garments List */
  .editorial-garments-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin-bottom: 3rem;
  }

  .editorial-garment-item {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding: 1.4rem;
    border: 1px solid #ebebeb;
    border-radius: 6px;
    background: #ffffff;
    transition: all 0.25s ease;
    text-decoration: none;
    color: inherit;
  }

  .editorial-garment-item:hover {
    border-color: #121212;
    transform: translateX(4px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .editorial-garment-thumb {
    width: 72px;
    height: 90px;
    object-fit: cover;
    border-radius: 4px;
    background: #f4f4f4;
    flex-shrink: 0;
  }

  .editorial-garment-info {
    flex: 1;
    min-width: 0;
  }

  .editorial-garment-cat {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #888888;
    margin: 0 0 0.3rem;
    font-weight: 600;
  }

  .editorial-garment-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: #121212;
    line-height: 1.3;
  }

  .editorial-garment-price {
    font-size: 1.4rem;
    font-weight: 600;
    color: #121212;
    margin: 0;
  }

  .editorial-garment-cta {
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #121212;
    padding: 0.8rem 1.6rem;
    border: 1px solid #121212;
    border-radius: 4px;
    transition: all 0.2s ease;
    white-space: nowrap;
    text-decoration: none;
  }

  .editorial-garment-item:hover .editorial-garment-cta {
    background: #121212;
    color: #ffffff;
  }

  /* Bottom Actions */
  .editorial-total-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.8rem 2.2rem;
    background: #f7f7f7;
    border-radius: 6px;
  }

  .editorial-total-label {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #666666;
    margin: 0 0 0.2rem;
  }

  .editorial-total-price {
    font-size: 1.8rem;
    font-weight: 800;
    color: #121212;
    margin: 0;
  }

  .editorial-total-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #121212;
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 1.2rem 2.4rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .editorial-total-btn:hover {
    background: #333333;
  }

  @media screen and (max-width: 989px) {
    .editorial-spotlight-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .editorial-visual-img {
      min-height: 420px;
      max-height: 500px;
    }
  }

  @media screen and (max-width: 550px) {
    .editorial-garment-item {
      padding: 1rem;
      gap: 1.2rem;
    }
    .editorial-garment-thumb {
      width: 56px;
      height: 70px;
    }
    .editorial-garment-title {
      font-size: 1.3rem;
    }
    .editorial-garment-cta {
      display: none;
    }
    .editorial-total-box {
      flex-direction: column;
      gap: 1.4rem;
      text-align: center;
    }
    .editorial-total-btn {
      width: 100%;
    }
  }
{%- endstyle -%}

<section class="editorial-spotlight-{{ section.id }}" id="editorial-spotlight">
  <div class="editorial-spotlight-container">
    <div class="editorial-spotlight-layout">
      
      {%- comment -%} Left Column: Campaign Editorial Image {%- endcomment -%}
      <div class="editorial-visual-wrap">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: 'editorial-visual-img',
              alt: section.settings.heading
          }}
        {%- else -%}
          <img
            src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=1400&auto=format&fit=crop"
            alt="Atelier Noir Autumn / Winter 2026 Campaign"
            class="editorial-visual-img"
            width="1400"
            height="1000"
            loading="lazy"
          >
        {%- endif -%}

        <div class="editorial-visual-overlay">
          <span>{{ section.settings.image_tagline | default: 'LOOK 04 // RUNWAY EDITORIAL' }}</span>
          <span class="editorial-visual-tag">PARIS STUDIO</span>
        </div>
      </div>

      {%- comment -%} Right Column: Ensemble Pieces {%- endcomment -%}
      <div class="editorial-content-wrap">
        <span class="editorial-subheading">{{ section.settings.subtitle }}</span>
        <h2 class="editorial-heading">{{ section.settings.heading }}</h2>
        <p class="editorial-desc">{{ section.settings.description }}</p>

        <div class="editorial-garments-list">
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.url | default: '/products/oversized-double-breasted-wool-trench' }}" class="editorial-garment-item" {{ block.shopify_attributes }}>
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.title }}"
                class="editorial-garment-thumb"
                width="72"
                height="90"
                loading="lazy"
              >
              <div class="editorial-garment-info">
                <p class="editorial-garment-cat">{{ block.settings.category }}</p>
                <h3 class="editorial-garment-title">{{ block.settings.title }}</h3>
                <p class="editorial-garment-price">{{ block.settings.price }}</p>
              </div>
              <span class="editorial-garment-cta">View Piece →</span>
            </a>
          {%- endfor -%}
        </div>

        <div class="editorial-total-box">
          <div>
            <p class="editorial-total-label">Complete 3-Piece Ensemble</p>
            <p class="editorial-total-price">$1,020.00 USD</p>
          </div>
          <a href="{{ routes.all_products_collection_url }}" class="editorial-total-btn">
            Explore Runway Drop →
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Ensemble",
  "tag": "section",
  "class": "section-editorial-spotlight",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "EDITORIAL SPOTLIGHT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Monolith Silhouette"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "An architectural dialogue between heavyweight Italian virgin wool and fluid Japanese gabardine. Cut with deliberate dropped proportions for a statuesque runway break."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign Image"
    },
    {
      "type": "text",
      "id": "image_tagline",
      "label": "Image Tagline Overlay",
      "default": "LOOK 04 // RUNWAY EDITORIAL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "garment",
      "name": "Ensemble Garment",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category / Material",
          "default": "520GSM VIRGIN WOOL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Garment Title",
          "default": "Oversized Double-Breasted Wool Trench"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$420.00"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Product Link"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Thumbnail Image URL",
          "default": "https://images.unsplash.com/photo-1544022613-e87ca75a784a?q=80&w=200&auto=format&fit=crop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Ensemble",
      "blocks": [
        {
          "type": "garment",
          "settings": {
            "category": "520GSM HEAVYWEIGHT WOOL",
            "title": "Oversized Double-Breasted Wool Trench",
            "price": "$420.00",
            "image_url": "https://images.unsplash.com/photo-1544022613-e87ca75a784a?q=80&w=200&auto=format&fit=crop"
          }
        },
        {
          "type": "garment",
          "settings": {
            "category": "JAPANESE GABARDINE TWILL",
            "title": "Pleated Architectural Wide-Leg Trouser",
            "price": "$240.00",
            "image_url": "https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=200&auto=format&fit=crop"
          }
        },
        {
          "type": "garment",
          "settings": {
            "category": "FULL-GRAIN TUSCAN CALFSKIN",
            "title": "Artisanal Box Calf Crossbody Bag",
            "price": "$360.00",
            "image_url": "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?q=80&w=200&auto=format&fit=crop"
          }
        }
      ]
    }
  ]
}
{% endschema %}

